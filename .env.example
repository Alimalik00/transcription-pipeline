# Copy this file to .env and adjust values for your environment.
# The app reads these at startup via app/core/config.py

HOST=0.0.0.0
PORT=8000

# Directory where uploaded audio files are stored temporarily
UPLOAD_DIR=/tmp/transcription/uploads

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower and uses more RAM
# 'base' is a good default for most use cases
WHISPER_MODEL=base

# Max upload size in bytes (default: 100 MB)
MAX_FILE_SIZE=104857600

# Chunk duration in seconds for long audio files
CHUNK_DURATION=30

# Overlap between chunks in seconds to avoid cutting words at boundaries
CHUNK_OVERLAP=1
